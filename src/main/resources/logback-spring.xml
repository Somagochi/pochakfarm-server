<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty name="DISCORD_WEBHOOK_URL" source="app.discord.webhook-url" defaultValue=""/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
  </appender>

  <appender name="DISCORD" class="com.somagochi.pochakfarm.common.logging.DiscordLogbackAppender">
    <webhookUrl>${DISCORD_WEBHOOK_URL}</webhookUrl>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
  </appender>
  <appender name="ASYNC_DISCORD" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="DISCORD"/>
    <discardingThreshold>0</discardingThreshold>
    <queueSize>512</queueSize>
  </appender>

  <springProfile name="local,test">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="dev,prod">
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_DIR}/pochakfarm-app.json</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_DIR}/pochakfarm-app-%d{yyyy-MM-dd}.%i.json</fileNamePattern>
        <maxFileSize>100MB</maxFileSize>
        <maxHistory>14</maxHistory>
        <totalSizeCap>3GB</totalSizeCap>
      </rollingPolicy>
      <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <logger name="org.zalando.logbook.Logbook" level="TRACE"/>
    <root level="INFO">
      <appender-ref ref="JSON_CONSOLE"/>
      <appender-ref ref="JSON_FILE"/>
      <appender-ref ref="ASYNC_DISCORD"/>
    </root>
  </springProfile>
</configuration>
